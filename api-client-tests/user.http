###GET ALL USERS
GET http://localhost:4000/users

###CREATE NEW USER
POST http://localhost:4000/users
Content-Type: application/json

{
    "name": "Usuario1",
    "email": "usuario1@email.com",
    "password": "123456"
}

###GET USER BY ID
GET http://localhost:4000/users/68d2d2c84bde310bc890ca3c




###UPDATE USER
PUT http://localhost:4000/users/68d2d2c84bde310bc890ca3c
Content-Type: application/json

{
    "name": "Usuario1Mod"
}




###DELETE USER 
DELETE http://localhost:4000/users/68d230ebf5fea07e5dbfa71b





###GET USER BOARDS(CURRENT USER)
GET http://localhost:4000/users/68d2d8c25a7e899b25e6eab1/boards


###GET USER BOARDS(ANOTHER USER)
GET http://localhost:4000/users/68d2d833977f17d02f965312/boards



###GET USER LISTS(CURRENT USER)
GET http://localhost:4000/users/68d2d8c25a7e899b25e6eab1/lists


###GET USER LISTS(ANOTHER USER)
GET http://localhost:4000/users/68d2d833977f17d02f965312/lists